  "item-7kiun": {
    "ko": "개굴!",
    "type": "기타",
    "common": false,
    "games": [
      "chris-mas"
    ],
    "intent": "크리마스 청개구리 문제",
    "tr": {
      "en": {
        "text": "ribbit!",
        "status": "확정",
        "avoid": "",
        "avoidWhy": ""
      },
      "ja": {
        "text": "ケロ！",
        "status": "후보",
        "avoid": "",
        "avoidWhy": ""
      },
      "zh": {
        "text": "呱呱!",
        "status": "후보",
        "avoid": "",
        "avoidWhy": ""
      }
    },
    "memo": "[게임 규칙 특이사항: 오답 선택형 퀴즈]  이 게임은 일반적인 퀴즈와 달리, 각 문제에서 사실에 맞는 정답이 아닌 오답을 선택해야 한다.  문제와 선택지는 원문의 사실관계를 그대로 유지한다.  실제 정답과 게임에서 선택해야 하는 오답을 혼동하지 않는다.  문제의 의미나 선택지의 정답 여부를 번역 과정에서 변경하지 않는다.  번역문만 읽어도 문제의 본래 의미가 동일하게 전달되어야 한다.  게임 규칙 설명에는 '정답이 아닌 선택지를 고르라'는 내용을 명확하게 전달한다.",
    "updatedAt": "2026-11-03T01:23:41.834Z"
  },
